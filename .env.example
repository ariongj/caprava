# Public URL of the site (used for Stripe redirects, sitemap and SEO tags)
NEXT_PUBLIC_SITE_URL=https://caprava.com

# --- Card payments (optional) ---------------------------------------------
# Leave empty to offer only cash on delivery. When set, the checkout offers
# card payment through Stripe Checkout.
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook pointing at /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Order & form notifications (optional, use one or both) ---------------
# Email through Resend (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=orders@caprava.com
NOTIFY_EMAIL_FROM=CAPRAVA <orders@caprava.com>
# Any URL that accepts a JSON POST (Zapier, Make, Slack, Google Apps Script…)
NOTIFY_WEBHOOK_URL=
